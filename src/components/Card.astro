---
import type { BlogLikeEntry } from "@/utils/contentCollections";
import { ArticleTime } from "@/utils/articleTime";
import { formatFeedDate, PostUtils } from "@/utils/postUtils";
import { SITE } from "@/config";
import { siteImageHref } from "@/utils/blogImages";

type BlogCardProps = BlogLikeEntry & {
  mode?: "post";
  openInNewTab?: boolean;
  listKind?: "article" | "weekly";
  itemClass?: string;
  hidden?: boolean;
  dateFormat?: "relative" | "absolute";
};

interface FeedCardProps {
  mode: "feed";
  title: string;
  link: string;
  published: string;
  blogName?: string;
  favicon?: string;
}

export type Props = BlogCardProps | FeedCardProps;

const rawProps = Astro.props as Props;
const isFeedCard = rawProps.mode === "feed";

const blogProps = rawProps as BlogCardProps;
const feedProps = rawProps as FeedCardProps;

const openInNewTab = !isFeedCard ? (blogProps.openInNewTab ?? true) : false;
const listKind = !isFeedCard ? (blogProps.listKind ?? "article") : "feed";
const itemClass = !isFeedCard ? blogProps.itemClass : undefined;
const hidden = !isFeedCard ? (blogProps.hidden ?? false) : false;
const dateFormat = !isFeedCard
  ? (blogProps.dateFormat ?? "relative")
  : "relative";
const data = !isFeedCard ? blogProps.data : undefined;
const id = !isFeedCard ? blogProps.id : undefined;
const filePath = !isFeedCard ? blogProps.filePath : undefined;
const collection = !isFeedCard ? blogProps.collection : undefined;

const title = isFeedCard ? feedProps.title : data!.title;
const date = !isFeedCard ? data!.date : undefined;
const updated = !isFeedCard ? data!.updated : undefined;
const timezone = !isFeedCard ? data!.timezone : undefined;
const listFaviconSrc = isFeedCard
  ? undefined
  : PostUtils.resolveArticleListFaviconImgSrc(data!.favicon, data!.categories);

const weeklyDescription =
  !isFeedCard && listKind === "weekly"
    ? (
        data!.description?.trim() ||
        PostUtils.getDescription(blogProps.body ?? "")
      ).trim()
    : "";

const feedDate = isFeedCard ? formatFeedDate(feedProps.published) : "";
const feedBlogName = isFeedCard ? (feedProps.blogName?.trim() ?? "") : "";

const articleListTime =
  !isFeedCard && listKind !== "weekly"
    ? ArticleTime.getDisplay(date!, updated, timezone, dateFormat)
    : null;

let avatarSrc = "";
if (isFeedCard) {
  avatarSrc = feedProps.favicon?.trim() || SITE.feeds.fallbackAvatarUrl || "";
  if (
    avatarSrc &&
    !/^https?:\/\//.test(avatarSrc) &&
    !avatarSrc.startsWith("//")
  ) {
    if (
      !avatarSrc.startsWith("/images/") &&
      !avatarSrc.startsWith("/feeds/") &&
      !avatarSrc.startsWith("/favicons/")
    ) {
      const name = avatarSrc.replace(/^\//, "");
      avatarSrc = `/feeds/${name}`;
    }
    avatarSrc = siteImageHref(avatarSrc);
  }
}
---

<li class:list={["pcard", itemClass, { hidden }]}>
  <div class="pcard-inner">
    {
      isFeedCard
        ? avatarSrc && (
            <img
              src={avatarSrc}
              alt=""
              width={44}
              height={44}
              loading="lazy"
              decoding="async"
            />
          )
        : listFaviconSrc && (
            <img
              src={listFaviconSrc}
              alt={title}
              width={44}
              height={44}
              loading="lazy"
              decoding="async"
            />
          )
    }
    <div class="pcard-body">
      {
        isFeedCard ? (
          <p class="pcard-title">
            {feedProps.link && feedProps.link !== "#" ? (
              <a
                href={feedProps.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {title || "无标题"}
              </a>
            ) : (
              <span>{title || "无标题"}</span>
            )}
          </p>
        ) : (
          <p class="pcard-title">
            <a
              href={PostUtils.getPath(
                id!,
                filePath!,
                true,
                date!,
                timezone,
                data?.slug,
                collection!
              )}
              target={openInNewTab ? "_blank" : undefined}
              rel={openInNewTab ? "noopener noreferrer" : undefined}
            >
              {title}
            </a>
          </p>
        )
      }
      {
        isFeedCard ? (
          <div class="pcard-meta">
            <span data-feed-published={feedProps.published}>{feedDate}</span>
            {feedBlogName && (
              <>
                <span aria-hidden="true">·</span>
                <span>{feedBlogName}</span>
              </>
            )}
          </div>
        ) : (
          <>
            {listKind !== "weekly" && articleListTime && (
              <div class="pcard-meta">
                <time
                  class="pcard-meta__time"
                  datetime={articleListTime.iso}
                  title={articleListTime.titleAttr}
                  data-date-format={dateFormat}
                >
                  {articleListTime.display}
                </time>
              </div>
            )}
            {listKind === "weekly" && (
              <>
                {weeklyDescription && (
                  <p class="pcard-desc">{weeklyDescription}</p>
                )}
              </>
            )}
          </>
        )
      }
    </div>
    <div class="pcard-arrow">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </div>
  </div>
</li>

<style is:global>
  .pcard {
    --pcard-thumb-size: 44px;
    --pcard-padding-y: 0.875rem;
    --pcard-padding-x: 1rem;
    --pcard-inner-gap: 0.875rem;
    --pcard-title-size: 0.9375rem;
    --pcard-title-line-height: 1.45;
    --pcard-title-lines: 2;
    --pcard-title-gap: 0.5rem;
    --pcard-meta-size: 0.8125rem;
    --pcard-meta-line-height: 1.5;
    --pcard-inner-min-thumb-slack: 0.25rem;
  }

  .pcard {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pcard.hidden {
    display: none;
  }

  .pcard-inner {
    display: flex;
    gap: var(--pcard-inner-gap);
    align-items: flex-start;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--background);
    padding: var(--pcard-padding-y) var(--pcard-padding-x);
    transition: all 0.25s ease;
    min-height: max(
      calc(var(--pcard-thumb-size) + var(--pcard-inner-min-thumb-slack)),
      calc(
        var(--pcard-title-size) * var(--pcard-title-line-height) *
          var(--pcard-title-lines) + var(--pcard-title-gap) +
          var(--pcard-meta-size) * var(--pcard-meta-line-height) +
          var(--pcard-padding-y) * 2
      )
    );
    box-shadow: 0 1px 2px color-mix(in srgb, var(--text-secondary) 5%, transparent);
  }

  .pcard-inner:hover {
    background: var(--background);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .pcard-inner > img {
    width: var(--pcard-thumb-size);
    min-width: var(--pcard-thumb-size);
    max-width: none;
    height: var(--pcard-thumb-size);
    flex: 0 0 var(--pcard-thumb-size);
    flex-shrink: 0;
    align-self: flex-start;
    display: block;
    border-radius: 10px;
    object-fit: cover;
    background: var(--background-secondary);
    padding: 0.35rem;
    transition: transform 0.25s ease;
  }

  .pcard-inner:hover > img {
    transform: scale(1.05);
  }

  .pcard-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
  }

  .pcard :where(ul, ol, menu) {
    padding-left: 0;
  }

  .pcard-title {
    margin: 0 0 var(--pcard-title-gap);
    font-size: var(--pcard-title-size);
    line-height: var(--pcard-title-line-height);
    color: var(--text-primary);
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .pcard-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pcard-inner:hover .pcard-title a {
    color: var(--accent);
  }

  .pcard-meta {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    font-size: var(--pcard-meta-size);
    line-height: var(--pcard-meta-line-height);
    color: var(--text-secondary);
    overflow: hidden;
    white-space: nowrap;
  }

  .pcard-meta__time {
    font-weight: 400;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: inherit;
  }

  .pcard-meta :is(span, a) {
    font-size: inherit;
    line-height: inherit;
  }

  .pcard-meta > :first-child {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .pcard-meta > :not(:first-child):not([aria-hidden="true"]) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pcard-meta a {
    display: inline-block;
    min-width: 0;
    max-width: 100%;
    color: var(--accent);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pcard-meta a:hover {
    text-decoration: underline;
  }

  .pcard-desc {
    margin: 0;
    font-size: var(--pcard-meta-size);
    line-height: var(--pcard-meta-line-height);
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    overflow: hidden;
  }

  .pcard-meta > [aria-hidden="true"] {
    flex: 0 0 auto;
    opacity: 0.5;
  }

  .pcard-arrow {
    flex: 0 0 auto;
    align-self: center;
    color: var(--text-secondary);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.25s ease;
  }

  .pcard-inner:hover .pcard-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent);
  }

  .post-cards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-inline-start: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .pcard {
      --pcard-inner-min-thumb-slack: 0.2rem;
      --pcard-padding-y: 0.75rem;
      --pcard-padding-x: 0.875rem;
      --pcard-inner-gap: 0.75rem;
      --pcard-title-size: 0.9rem;
      --pcard-meta-size: 0.7875rem;
      --pcard-title-gap: 0.4rem;
      --pcard-title-line-height: 1.42;
      --pcard-meta-line-height: 1.45;
    }

    .pcard-inner > img {
      flex-shrink: 0;
      border-radius: 8px;
      padding: 0.3rem;
    }

    .post-cards-list {
      gap: 0.6rem;
    }

    .pcard-arrow {
      display: none;
    }
  }
</style>